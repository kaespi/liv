<Window x:Class="liv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="liv — Lightweight Image Viewer"
        Icon="liv.ico"
        WindowState="Maximized"
        Background="Black"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged">

    <Grid x:Name="RootGrid"
          ClipToBounds="True"
          Background="Black"
          MouseWheel="RootGrid_MouseWheel"
          MouseMove="RootGrid_MouseMove"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
          MouseLeftButtonUp="RootGrid_MouseLeftButtonUp">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Image display — spans the full grid -->
        <Image x:Name="ImageDisplay"
               Grid.ColumnSpan="3"
               Stretch="Uniform"
               RenderTransformOrigin="0.5,0.5"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <!-- Left navigation overlay (visual indicator only, hit-testing is on the Grid) -->
        <Border x:Name="LeftNavZone"
                Grid.Column="0"
                Background="Transparent"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Left"
                Margin="16,0,0,0">
            <Path Data="M 24,8 L 8,28 L 24,48"
                  Stroke="White" StrokeThickness="3"
                  Opacity="0.6"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="32" Height="56"
                  Stretch="Uniform" />
        </Border>

        <!-- Right navigation overlay -->
        <Border x:Name="RightNavZone"
                Grid.Column="2"
                Background="Transparent"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Right"
                Margin="0,0,16,0">
            <Path Data="M 8,8 L 24,28 L 8,48"
                  Stroke="White" StrokeThickness="3"
                  Opacity="0.6"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="32" Height="56"
                  Stretch="Uniform" />
        </Border>
    </Grid>
</Window>
